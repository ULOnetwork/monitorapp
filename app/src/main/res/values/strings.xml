    <string name="app_name">UnetworkMonitor</string>
    <string name="accessibility_service_description">UnetworkMonitor reads the text visible on screen to compare it against a list of self-configured keywords. No text is stored or transmitted, except for a short excerpt around a matched keyword in this app\'s own alert log.</string>

    <string name="nav_status">Status</string>
    <string name="nav_rules">Keywords</string>
    <string name="nav_log">Alert log</string>
    <string name="nav_settings">E-mail settings</string>

    <string name="consent_title">Before you continue</string>
    <string name="consent_body">UnetworkMonitor uses an Accessibility Service to read the text visible on screen, across all apps used on this device. This text is compared against a list of keywords that you configure yourself. On a match, the app can show a local notification and/or send an e-mail.\n\nOnly install and use this app on a device that you own yourself, or for which you have the explicit permission of the owner/user to monitor it. Reading screen text without the consent of the device\'s user may be in violation of privacy laws and regulations.\n\nThe app is always visible in the app list with its normal icon and normal name \"UnetworkMonitor\", and never hides itself.</string>
    <string name="consent_agree">I agree</string>

    <string name="status_title">Status</string>
    <string name="status_explanation">UnetworkMonitor checks the text on your screen against self-configured keywords and warns you via a notification and/or e-mail when a keyword is found. This requires the Accessibility Service, plus permission to show notifications.</string>
